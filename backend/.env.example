PORT=4000
# Local MongoDB works immediately if your MongoDB service is running.
# For the tutorial, replace this with YOUR Atlas Drivers connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/finals_mevn_db
# Example only: mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/finals_mevn_db?retryWrites=true&w=majority
CLIENT_URL=http://localhost:8080
NODE_ENV=development
